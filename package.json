{
  "name": "go-struct-analyzer",
  "displayName": "Go Struct Analyzer",
  "description": "Shows size and padding information for Go structs",
  "version": "2.0.3",
  "publisher": "PatricioDiaz",
  "author": {
    "name": "Patricio Diaz (padiazg@gmail.com)"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/padiazg/go-struct-analyzer"
  },
  "homepage": "https://github.com/padiazg/go-struct-analyzer",
  "bugs": {
    "url": "https://github.com/padiazg/go-struct-analyzer/issues"
  },
  "icon": "icon.png",
  "keywords": [
    "go",
    "golang",
    "struct",
    "memory",
    "padding",
    "alignment",
    "optimization"
  ],
  "galleryBanner": {
    "color": "#00ADD8",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:go"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "goStructAnalyzer.analyzeStruct",
        "title": "Analyze Struct Layout",
        "category": "Go Struct"
      }
    ],
    "configuration": {
      "title": "Go Struct Analyzer",
      "properties": {
        "goStructAnalyzer.showInlineAnnotations": {
          "type": "boolean",
          "default": false,
          "description": "Show size annotations inline with struct fields"
        },
        "goStructAnalyzer.showPadding": {
          "type": "boolean",
          "default": true,
          "description": "Highlight padding bytes in struct layout"
        },
        "goStructAnalyzer.architecture": {
          "type": "string",
          "enum": [
            "amd64",
            "386",
            "arm64",
            "arm"
          ],
          "default": "amd64",
          "description": "Target architecture for size calculations"
        },
        "goStructAnalyzer.enableStructOptimizationWarnings": {
          "type": "boolean",
          "default": true,
          "description": "Show warnings for structs that can be optimized for better memory layout"
        },
        "goStructAnalyzer.enableReorderCodeAction": {
          "type": "boolean",
          "default": true,
          "description": "Show quick fix to reorder struct fields for optimal memory layout"
        },
        "goStructAnalyzer.reorderCodeActionPreferred": {
          "type": "boolean",
          "default": false,
          "description": "Mark reorder quick fix as preferred (enables auto-apply with source.fixAll). Disabled by default to prevent accidental edits."
        },
        "goStructAnalyzer.enableGCPressureWarnings": {
          "type": "boolean",
          "default": true,
          "description": "Show hints for structs where reordering pointer fields would reduce the GC scan range."
        },
        "goStructAnalyzer.gcPressureSeverityWarning": {
          "type": "boolean",
          "default": false,
          "description": "Show GC pressure issues as warnings (yellow underline) instead of hints. Requires enableGCPressureWarnings to be true."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile:go": "go build -o gsa-lsp ./cmd/gsa-lsp",
    "compile:ts": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node",
    "compile": "npm run compile:go && npm run compile:ts",
    "watch": "npm run esbuild -- --watch",
    "esbuild": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node"
  },
  "devDependencies": {
    "@types/node": "22.x",
    "@types/vscode": "^1.74.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "vscode-languageclient": "^10.1.0"
  }
}
